# Projet Supabase de staging (valeurs publiques : URL et clé publiable, jamais la clé service_role).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Site web, pour les liens (mot de passe oublié, documents légaux).
EXPO_PUBLIC_SITE_URL=https://menao.fr
# Projet Expo (expo.dev) : nécessaire pour ouvrir l'app dans Expo Go et pour les builds EAS.
# Identifiant du projet, pas un secret, mais gardé hors du dépôt avec le reste de la configuration.
EAS_PROJECT_ID=
# Connexion avec Google ou Apple pour les clients (« google,apple »), une fois configurés dans
# Supabase Auth ; vide : aucun bouton (ADR 0108).
EXPO_PUBLIC_OAUTH_PROVIDERS=

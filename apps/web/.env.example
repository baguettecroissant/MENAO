# Copier en .env.local (ignoré par Git). Ne jamais committer de vraies valeurs.
# En local : valeurs affichées par `pnpm db:start` (Supabase local).
# Sur Vercel : variables du projet Supabase menao-staging (Preview) ou production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé publique (« publishable » ou ancienne clé « anon »). Jamais la clé secrète / service_role ici.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (optionnel : désactivé si vide)
NEXT_PUBLIC_SENTRY_DSN=
# Envoi des sourcemaps au build (optionnel, serveur de build uniquement)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

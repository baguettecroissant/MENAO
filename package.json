{
  "name": "menao",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts && prettier --write packages/db/src/types.ts",
    "functions:check": "for d in supabase/functions/*/; do (cd \"$d\" && deno check index.ts) || exit 1; done"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "@menao/config": "workspace:*"
  },
  "type": "module"
}
